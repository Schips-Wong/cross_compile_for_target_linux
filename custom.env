## make 编译时，指定的最大线程数
MKTHD="-j 30"


## 编译架构
#export BUILD_ARCH=arm
export BUILD_ARCH=arm64

## 编译工具链前缀
#export BUILD_HOST=arm-linux
export BUILD_HOST=arm-linux-gnueabi

## 编译工具链的所在路径（可选）
export BUILD_HOST_PATH=/opt/gcc-arm-linux-gnueabi/bin

## 强制指定_CC的变量内容
## 如果空，则默认为 ${BUILD_HOST_}gcc ..
## 有些特殊的CC会用 'aarch-xx-gcc --sysroot=xxx' 作为完整的gcc命令
export SET_FORCE_CC=""
export SET_FORCE_CPP=""
export SET_FORCE_CXX=""
export SET_FORCE_LD=""
export SET_FORCE_AR=""
export SET_FORCE_RANLIB=""
export SET_FORCE_STRIP=""

